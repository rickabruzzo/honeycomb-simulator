# Vercel KV (Redis) Configuration
# These are automatically set by Vercel, or you can get them via `vercel env pull`
KV_REST_API_READ_ONLY_TOKEN=""
KV_REST_API_TOKEN=""
KV_REST_API_URL=""
KV_URL=""
REDIS_URL=""

# Mock LLM for local development
USE_MOCK_LLM="true"

# OpenTelemetry Configuration for Honeycomb
# NOTE: These should ONLY be set in Vercel Production environment variables
# DO NOT set these in .env.local for local development
# See HONEYCOMB_SETUP.md for configuration instructions

# ── Attendee generation ───────────────────────────────────────────────────────
# CHAT_PROVIDER: "gateway" (preferred) | "openai" (fallback) | unset (mock)
#
# Gateway auth comes from `vercel env pull` (VERCEL_OIDC_TOKEN) or AI_GATEWAY_API_KEY.
# NOTE: the Gateway also requires a payment method on the Vercel team before it will
# serve generation requests, even while free credits are available. Model listing works
# without one; generation returns 403 customer_verification_required.
#
# Resolve model slugs with: node --env-file=.env.local scripts/smoke-gateway.mjs
CHAT_PROVIDER="openai"
ATTENDEE_MODEL=""                # gateway only, e.g. anthropic/claude-sonnet-5
JUDGE_MODEL=""                   # reserved for the phase 2 turn-signal judge

# Applies to both gateway and openai providers. Previously hardcoded at 0.4 / 300, which
# flattened every reply and capped venting before the length budget could take effect.
ATTENDEE_TEMPERATURE="0.8"
ATTENDEE_MAX_TOKENS="700"

# Canonical, absolute base URL for shareable links (practice invites, scorecards, leaderboard,
# insights). Set this so copied links point at the real site instead of whatever ephemeral
# *-<hash>.vercel.app deployment the admin was viewing. No trailing slash.
NEXT_PUBLIC_SITE_URL="https://honeycomb-simulator.vercel.app"
